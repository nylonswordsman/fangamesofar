;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="fangamesofar"
config/version="dawg this aint even in alpha"
config/tags=PackedStringArray("sunday_project")
run/main_scene="uid://beqeulrol1eji"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60
boot_splash/use_filter=false
config/icon="uid://cmysp1rpojswq"

[audio]

buses/default_bus_layout="uid://cdjm5hcem3hhu"

[autoload]

